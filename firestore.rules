rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each person's progress lives at progress/<private code from their link>.
    // Codes can't be listed, so only someone with the link can read or change it.
    match /progress/{code} {
      allow get: if code.matches('^[a-z0-9]{20,64}$');
      allow create, update: if code.matches('^[a-z0-9]{20,64}$')
        && request.resource.data.keys().hasOnly(['state', 'updatedAt'])
        && request.resource.data.state is string
        && request.resource.data.state.size() < 200000
        && request.resource.data.updatedAt is number;
    }
  }
}
